    {
      "id": "PRN-000012",
      "title": "Separate independent engineering decisions",
      "file_id": "coding.principles",
      "file_path": "domains/coding/principles.md",
      "status": "active",
      "last_reviewed": "2026-09-02",
      "reviewed_content_sha256": "906c9069300bbc9b1bede38f27c2c6eb5285f614de59721137821854f7aeca2b",
      "input_sha256": "91c4304a4c07fdabc55a5f32c9197974b8815011831a880a68e6370bc6f854ae",
      "statement": {
        "role": "statement",
        "text": "Separate decisions that can be understood, verified, and reversed independently; combine work only when separation would leave an incomplete change. [coding.principles:4], [coding.principles:5]",
        "claim_sha256": "57cb2870a3ad6b9a529a9f0cd6219bbf08655a6f30cbebca53c480856c1e5600",
        "source_ids": [
          "SRC-000027",
          "SRC-000021"
        ]
      },
      "source_ids": [
        "SRC-000027",
        "SRC-000021"
      ],
      "source_inputs": [
        {
          "id": "SRC-000027",
          "status": "moved",
          "path": "sources/SRC-000027.yaml",
          "input_sha256": "901cd4b2b31677770afcc455f64055aa98a6c7a0fd2600e763a7bf149b70b15f"
        },
        {
          "id": "SRC-000021",
          "status": "superseded",
          "path": "sources/SRC-000021.yaml",
          "input_sha256": "def5ffa1b48709fdd9481345f8b328753582aa652f101a016ac1e81a51e43fa7"
        }
      ],
      "references": [
        {
          "label": "coding.principles:4",
          "source_id": "SRC-000027",
          "title": "Small CLs"
        },
        {
          "label": "coding.principles:5",
          "source_id": "SRC-000021",
          "title": "gitworkflows — An overview of recommended workflows with Git"
        }
      ],
      "why": [
        {
          "role": "why-1",
          "text": "Isolating one decision preserves causal information and limits the work that must be reconsidered when evidence fails. The useful unit is a complete idea, not an arbitrary line count. [coding.principles:4], [coding.principles:5]",
          "claim_sha256": "4357bada0db31a83233703fd3f25f445ea2ebc38e88b65472c6997ab22a58ddc",
          "source_ids": [
            "SRC-000027",
            "SRC-000021"
          ]
        }
      ],
      "practices": [
        {
          "role": "practice-1",
          "text": "Split work into self-contained outcomes that reviewers can understand and verify without relying on unfinished future work. [coding.principles:4]",
          "claim_sha256": "e9bbc63424b48a0ddc0ae64c3d60b5c906ad2494c5b4916af5e5f5d2a0bc335e",
          "source_ids": [
            "SRC-000027"
          ]
        },
        {
          "role": "practice-2",
          "text": "For dependent outcomes, order the steps so each completed step keeps the system working and carries the context needed to understand the next. [coding.principles:4]",
          "claim_sha256": "fcc203749438aadb2556a7da6e5b774ff53313b4d44ba10b098e000322f0cb84",
          "source_ids": [
            "SRC-000027"
          ]
        }
      ],
      "applicability": [
        {
          "role": "applicability-1",
          "text": "A complete change may be large when its parts cannot work or be evaluated independently; splitting must not create misleading or broken intermediate states. [coding.principles:4]",
          "claim_sha256": "fbe5baa03a15013398d10cdcee8e55d343f38a11cd9db83b5a21132f9bc828b7",
          "source_ids": [
            "SRC-000027"
          ]
        }
      ],
      "goals": [],
      "tags": [],
