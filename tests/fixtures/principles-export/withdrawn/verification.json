    {
      "id": "PRN-000014",
      "title": "Turn feedback into the next practice",
      "file_id": "coding.personal-growth",
      "file_path": "domains/coding/personal-growth.md",
      "status": "draft",
      "last_reviewed": null,
      "reviewed_content_sha256": null,
      "input_sha256": "28104038955ce7ebcb8e7a7a0eb6c65d0661fdc1f5eec949732f66e9823e9cb0",
      "statement": {
        "role": "statement",
        "text": "Use feedback from real work to choose one coding skill or decision pattern for focused, repeated practice. [coding.personal-growth:1], [coding.personal-growth:2]",
        "claim_sha256": "818c94be5f4ff70eb0545f417a4e332c28e3984ce6649643b82dbcdfc9611a12",
        "source_ids": [
          "SRC-000029",
          "SRC-000025"
        ]
      },
      "source_ids": [
        "SRC-000029",
        "SRC-000025"
      ],
      "source_inputs": [
        {
          "id": "SRC-000029",
          "status": "active",
          "path": "sources/SRC-000029.yaml",
          "input_sha256": "792e2fe8193f7a2d3f05cbee4580fc33b4535c24d6e9d080ec21ce45cb901d3f"
        },
        {
          "id": "SRC-000025",
          "status": "active",
          "path": "sources/SRC-000025.yaml",
          "input_sha256": "aa19fa16e2cb9357c5ab54ee9e8052f6b202c8b984acaf6dc609501d27677cf4"
        }
      ],
      "references": [
        {
          "label": "coding.personal-growth:1",
          "source_id": "SRC-000029",
          "title": "Deliberate Practice and Proposed Limits on the Effects of Practice on the Acquisition of Expert Performance: Why the Original Definition Matters and Recommendations for Future Research"
        },
        {
          "label": "coding.personal-growth:2",
          "source_id": "SRC-000025",
          "title": "Code of Ethics for Software Engineers"
        }
      ],
      "why": [
        {
          "role": "why-1",
          "text": "Experience alone does not create focused improvement. Practice built around a specific goal, repeated attempts, and informative feedback exposes the gap between current and intended performance. [coding.personal-growth:1]",
          "claim_sha256": "8176b29cbe4756e58ebddeb8c57ad49b93bd24b8536a22ade3679890fc04e179",
          "source_ids": [
            "SRC-000029"
          ]
        }
      ],
      "practices": [
        {
          "role": "practice-1",
          "text": "Set a concrete objective just beyond current reliable performance, rehearse it, and seek feedback that identifies the next adjustment. [coding.personal-growth:1]",
          "claim_sha256": "4664936d24af0bdd24228ca39a16699f92aaa3598058ae0f8a57f0f30f1943f9",
          "source_ids": [
            "SRC-000029"
          ]
        },
        {
          "role": "practice-2",
          "text": "Reassess observed performance and revise the exercise or objective instead of repeating practice that no longer targets the gap. [coding.personal-growth:1]",
          "claim_sha256": "3e06f4f6267147aa4df4477880f496a52b1511c7a5b4e06d56d5cbea581b0cb2",
          "source_ids": [
            "SRC-000029"
          ]
        }
      ],
      "applicability": [
        {
          "role": "applicability-1",
          "text": "Self-directed work with these features is purposeful practice. The cited research reserves deliberate practice for activities designed and monitored by a qualified teacher or coach, and its effects should not be generalized without regard to the field and learner. [coding.personal-growth:1]",
          "claim_sha256": "dc766c4cb245dab277e619651d44af6949301f542e0b00c382ed3baf33b22985",
          "source_ids": [
            "SRC-000029"
          ]
        }
      ],
      "goals": [
        {
          "role": "goal-1",
          "text": "Convert work outcomes into focused learning loops without treating every criticism as equally important.",
          "claim_sha256": null,
          "source_ids": []
        }
      ],
      "tags": [],
