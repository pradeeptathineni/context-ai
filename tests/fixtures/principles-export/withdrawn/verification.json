  "entries": [
    {
      "id": "PRN-000010",
      "title": "Make intent easy to recover",
      "file_id": "coding.principles",
      "file_path": "domains/coding/principles.md",
      "status": "active",
      "last_reviewed": "2026-09-02",
      "reviewed_content_sha256": "906c9069300bbc9b1bede38f27c2c6eb5285f614de59721137821854f7aeca2b",
      "input_sha256": "91c4304a4c07fdabc55a5f32c9197974b8815011831a880a68e6370bc6f854ae",
      "statement": {
        "role": "statement",
        "text": "Write code so another person can recover its purpose, behavior, and constraints without reconstructing avoidable complexity. [coding.principles:1], [coding.principles:2]",
        "claim_sha256": "8d110b134afe968acae0acf2fc169de946e4278dade506da05f3b3097ef93ee1",
        "source_ids": [
          "SRC-000001",
          "SRC-000003"
        ]
      },
      "source_ids": [
        "SRC-000001",
        "SRC-000003"
      ],
      "source_inputs": [
        {
          "id": "SRC-000001",
          "status": "withdrawn",
          "path": "sources/SRC-000001.yaml",
          "input_sha256": "f1fb77f94702a69a981f8d053bd37c35e3f1d5ffc72779bc3e3039afec112905"
        },
        {
          "id": "SRC-000003",
          "status": "active",
          "path": "sources/SRC-000003.yaml",
          "input_sha256": "3c659f9eeff33010b0ccec7c29b16137c9139c77db480aed80df98aac7779872"
        }
      ],
      "references": [
        {
          "label": "coding.principles:1",
          "source_id": "SRC-000001",
          "title": "Guide to the Software Engineering Body of Knowledge (SWEBOK Guide), Version 4.0a"
        },
        {
          "label": "coding.principles:2",
          "source_id": "SRC-000003",
          "title": "What to look for in a code review"
        }
      ],
      "why": [
        {
          "role": "why-1",
          "text": "Code is repeatedly read, reviewed, tested, debugged, and changed. Simple structure, meaningful names, and explicit boundaries reduce the mental context required for those activities and make defects easier to notice. [coding.principles:1], [coding.principles:2]",
          "claim_sha256": "704a9c5fa429488d85cc6067b7c4509124c53b0a14f1f189be66b77bf1b0eba5",
          "source_ids": [
            "SRC-000001",
            "SRC-000003"
          ]
        }
      ],
      "practices": [
        {
          "role": "practice-1",
          "text": "Prefer direct control flow, domain-meaningful names, and cohesive units over clever compression. [coding.principles:1], [coding.principles:2]",
          "claim_sha256": "76e8fc932a2d8fa29850bdabdd9546c2ec182eaede445bd81c9df97c11d49152",
          "source_ids": [
            "SRC-000001",
            "SRC-000003"
          ]
        },
        {
          "role": "practice-2",
          "text": "Put non-obvious reasons and constraints where future readers will encounter the affected code. [coding.principles:2]",
          "claim_sha256": "116ebb11fe4184b4fd03796e71ce6ce11ba17b0ec3502963d7706d619db841a1",
          "source_ids": [
            "SRC-000003"
          ]
        }
      ],
