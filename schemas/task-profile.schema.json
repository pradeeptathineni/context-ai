{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"$ref": "#/$defs/text"},
    "context": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "direct"},
            "resources": {"$ref": "#/$defs/strings"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "loadouts", "stages"],
          "properties": {
            "mode": {"const": "loadout"},
            "loadouts": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
            "stages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["inspect", "research", "design", "implement", "test", "review", "deliver"]}
            },
            "options": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/text"}
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"enum": ["required", "optional"]}
    },
    "model": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "orchestration": {
      "enum": ["single_agent", "separate_investigations", "separate_implementation", "fresh_review"]
    },
    "pact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"$ref": "#/$defs/text"}
      }
    },
    "verification": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
    "unresolved": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "strings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  }
}
