{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "command"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "resolver": {
                "enum": [
                  "python",
                  "node",
                  "package-manager",
                  "playwright"
                ]
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "command",
              "boundary"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "resource"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "path",
              "description",
              "boundary"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "text"
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              }
            },
            "required": [
              "description",
              "type",
              "max_length"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "default": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aliases": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    },
                    "incompatible": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "option": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "option",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "description",
                    "aliases"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "description",
              "default",
              "alternatives"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "capabilities",
    "options"
  ],
  "additionalProperties": false
}
