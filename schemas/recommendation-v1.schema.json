{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Optional advisory envelope carried in a frozen signals-evidence-v1 bundle under extensions['signals.recommendations']. It never replaces schema-v1 fields and grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "query",
    "items"
  ],
  "properties": {
    "version": {
      "const": "signals-recommendation-v1"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "capability",
          "action",
          "reason",
          "limitations",
          "provenance",
          "assessment_state"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "enum": [
              "use",
              "wrap",
              "adapt",
              "study",
              "watch",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_ids"
            ],
            "properties": {
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assessed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessor": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "assessment_state": {
            "enum": [
              "unassessed",
              "screened",
              "assessed",
              "contested"
            ]
          },
          "intrinsic_strength": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1
              },
              "runtime": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
