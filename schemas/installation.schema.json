{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "bound_project"
        ]
      }
    }
  ],
  "properties": {
    "agents_added_newline": {
      "type": "boolean"
    },
    "agents_created": {
      "type": "boolean"
    },
    "bound_project": {
      "minLength": 1,
      "type": "string"
    },
    "owned": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "resolution": {
      "$ref": "https://context-ai.local/schemas/lock.schema.json"
    },
    "routing_block": {
      "minLength": 1,
      "type": "string"
    },
    "routing_removed": {
      "type": "boolean"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "undo_pending": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "resolution",
    "owned",
    "routing_block",
    "agents_created"
  ],
  "type": "object"
}
