{
  "$id": "https://context-ai.local/schemas/lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "project": {
            "const": "."
          }
        }
      }
    }
  ],
  "properties": {
    "capabilities": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "definition": {
            "type": "object"
          },
          "requirement": {
            "enum": [
              "required",
              "optional"
            ]
          }
        },
        "required": [
          "requirement",
          "available",
          "definition"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "loadout": {
            "minLength": 1,
            "type": "string"
          },
          "recipe": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "loadout",
          "recipe"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "decisions": {
      "type": "object"
    },
    "library_revision": {
      "minLength": 1,
      "type": "string"
    },
    "loadouts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "options": {
      "additionalProperties": false,
      "properties": {
        "brand": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "design_procedure": {
          "enum": [
            "guided",
            "lightweight"
          ]
        }
      },
      "type": "object"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "const": "codex"
    },
    "resources": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "skills": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stages": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "inspect",
          "research",
          "design",
          "implement",
          "test",
          "review",
          "deliver"
        ]
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "project",
    "library_revision",
    "source_tree_sha256",
    "loadouts",
    "stages",
    "skills",
    "capabilities",
    "options",
    "checks",
    "decisions",
    "resources"
  ],
  "type": "object"
}
